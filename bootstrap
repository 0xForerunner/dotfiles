#!/bin/sh
set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
if ! command -v brew >/dev/null 2>&1; then
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        if [ -x "$candidate" ]; then
            eval "$("$candidate" shellenv)"
            break
        fi
    done
fi
command -v brew >/dev/null 2>&1 || {
    echo "Install Homebrew from https://brew.sh, then rerun ./bootstrap." >&2
    exit 1
}
# Install missing tools without upgrading existing installations.
brew bundle install --no-upgrade --file=Brewfile
git submodule update --init --recursive
stow --simulate --verbose .
stow .
if [ "$(uname -s)" = Darwin ]; then
    defaults write -g InitialKeyRepeat -int 15
    defaults write -g KeyRepeat -int 1
fi
printf '%s\n' 'Setup complete. Open a new terminal; in tmux, press prefix + I to install plugins.'
